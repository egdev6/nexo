{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Allow only the main flyout to hide itself and manage login startup.",
  "windows": ["main"],
  "permissions": ["core:window:allow-hide", "core:event:allow-listen", "core:event:allow-unlisten", "autostart:allow-is-enabled", "autostart:allow-enable", "autostart:allow-disable"]
}
